%暴力
class Solution{
    public int[] twoSum(int[] nums,int target){
		for(int i=0;i<nums.length;i++){
			for(int j=i+1;j<nums.length;j++){
				if(nums[i]+nums[j]==target){
					return new int[]{i,j};%new int[]{值1, 值2, 值3}
                }
			}
			
			}
            return new int[0];
	}
}
%hashmap
import java.util.HashMap;

class Solution {
    public int[] twoSum(int[] nums, int target) {
        // 创建一个 HashMap：
        // key 存数字，value 存这个数字对应的下标
		//键（key）= 你拿来查的东西
		//值（value）= 查到后得到的东西
        HashMap<Integer, Integer> map = new HashMap<>();

        // 遍历数组
        for (int i = 0; i < nums.length; i++) {
            // 当前数字还需要谁，才能凑成 target
            int need = target - nums[i];

            // 如果之前已经出现过 need
            if (map.containsKey(need)) {
                // 返回 need 的下标 和 当前下标
                return new int[]{map.get(need), i};
            }

            // 如果之前没出现过，就把当前数字和下标存起来
            map.put(nums[i], i);
        }

        // 兜底返回
        return new int[0];
    }
}